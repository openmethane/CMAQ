#! /bin/csh -f

# ================= CMAQ5.0.2 Configuration Script ================== #
# Requirements: I/O API & netCDF libs, PGI, Intel, Gnu Compiler       #
#               Collection (GCC), MPICH for multiprocessor computing  #
# Note that this script is configured/tested for Red Hat Linux O/S    #
#                                                                     #
# To report problems or request help with this script/program:        #
#             http://www.cmascenter.org/help_desk.cfm                 #
# =================================================================== #

#> config.cmaq
#> sourced from bldit.<model>

#> model repository location
if (! $?M3HOME) then
  setenv M3HOME /opt/cmaq
endif

setenv M3MODEL ${M3HOME}/models
setenv M3DATA  ${M3HOME}/data

#===============================================================================

#> architecture & compiler specific settings
#-------------------------------------------------------------------------------

#> set the COMPILER
setenv COMPILER gcc

setenv system "`/bin/uname -m`"
setenv bld_os "`/bin/uname -s`"
setenv lib_basedir $M3HOME/lib
setenv extra_lib

####### MPI libraries ########
#use -lmpich for mvpich and -lmpi for openmpi
 setenv mpi "-lmpich"

##> binaries and flags for gfortran compiler
setenv compiler gcc
setenv compiler_ext gfort
setenv myFC mpif90 #gfortran
setenv myCC mpicc
setenv myLINK_FLAG ""
setenv myFFLAGS "-ffixed-form -ffixed-line-length-132 -g -O2 -fbacktrace -fallow-argument-mismatch -funroll-loops -finit-character=32"
setenv myFRFLAGS "-ffree-form -ffree-line-length-none -g -O2 -fbacktrace -fallow-argument-mismatch -funroll-loops -finit-character=32"
setenv myCFLAGS "-g -O2"

#===============================================================================

#> generate library locations
if (! $?M3LIB) then
  setenv M3LIB /opt/lib
endif
if ( ! -d $M3LIB ) mkdir -p $M3LIB

if (! $?IOAPI_DIR) then
  setenv IOAPI_DIR $M3LIB/ioapi_3.1
endif

#> set executable id
setenv EXEC_ID ${bld_os}_${system}${compiler_ext}

#> Set location of libraries/include files
setenv MPI_INC "." # not needed when libmpich-dev installed via apt
setenv IOAPI_LIB "-L${IOAPI_DIR}/${EXEC_ID} -lioapi"
setenv IOAPI_MOD "${IOAPI_DIR}/${EXEC_ID}"
setenv NETCDF_LIB "`nf-config --flibs`"
setenv NETCDF_MOD "`nf-config --fflags`"
setenv PARIO_LIB "${M3LIB}/pario -lpario"
setenv STENEX_LIB "${M3LIB}/stenex/se_gcc8.3.0"
setenv STENEX_MOD "${M3LIB}/stenex/se_gcc8.3.0"

#> If $BIN_DIR is set, compiled binaries will be placed there
if ( $?BIN_DIR ) then
  if ( ! -d $BIN_DIR ) mkdir -p "$BIN_DIR"
endif
