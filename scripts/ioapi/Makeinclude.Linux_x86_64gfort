# Version "$Id: Makeinclude.Linux2_x86_64gfort 1 2014-03-14 20:22:54Z coats $"
#
#  12/2013 by CJC: Conditional preprocessor-code "-DNEED_ARGS=1"
#  to implement  IARGC() and GETARG() for compilers
#  ("gfortran" version 4.8 or later to be exact) that insist on
#  enforcing F2003-only with no backwards nor industry-standards compatibility.
#
#  Remove "-DNEED_ARGS=1" from ARCHFLAGS for version 4.7.x and earlier
#
# Use "-march=native -mtune=native" if compile-platform and compute-platform
# are the same.
# Use "-Wall -Wsurprising" for full diagnostics.

AR   = ar
CC   = mpicc
FC   = gfortran
M4   = m4
LINK = $(CC)

MODI = -J       ## Module-include-directory command

# Optimisation flags understood by both gcc and gfortran.
MFLAGS    = -ffast-math -funroll-loops -m64 -march=core-avx2 # -mtune=native #  -Wall -Wsurprising

# gfortran-only flags. Passing these to the C compiler produces
# "valid for Fortran but not for C" warnings, so keep them out of COPTFLAGS.
FMFLAGS   = -fbacktrace -fallow-argument-mismatch

# I/O API 3.1 is pre-C99 code. GCC 14 (Debian trixie) promotes these
# diagnostics from warnings to errors by default, which the upstream sources
# do not survive. Downgrade them back to warnings rather than patching the
# vendored tarball.
CLEGACY   = -std=gnu17 \
 -Wno-error=implicit-function-declaration \
 -Wno-error=implicit-int \
 -Wno-error=int-conversion \
 -Wno-error=incompatible-pointer-types \
 -Wno-error=return-mismatch \
 -Wno-error=declaration-missing-parameter-type

OMPFLAGS  = # -fopenmp
OMPLIBS   = # -fopenmp
COPTFLAGS = -g -O2 ${MFLAGS} ${CLEGACY}
FOPTFLAGS = -g -O2 ${MFLAGS} ${FMFLAGS}
FPPFLAGS  = -DF90=1
FSFLAGS   = -fno-automatic
ARCHFLAGS = \
 -DAUTO_ARRAYS=1 \
 -DF90=1 -DFLDMN=1 \
 -DFSTR_L=int \
 -DIOAPI_NO_STDOUT=0 \
 -DNEED_ARGS=1 \
 -DDEBUGGING=1
PARFLAGS  =
ARCHLIB   = -dynamic -lm -lpthread -lc `nf-config --flibs`

M4DEFFILE = $(PVM_ROOT)/conf/$(PVM_ARCH).m4
# PVMLIBS   = -lpvm3
